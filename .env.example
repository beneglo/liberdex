# Planner / answer LLM. Any one key is enough to run the engine; with none,
# liberdex uses the `claude` binary if it is installed, and inside an agent
# CLI (`liberdex mcp`) the host model writes the plan and no key is needed.
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Which model plays which role, as profile/model. Unset, the planner is the
# first provider above with a key, and the answer follows the planner.
# LIBERDEX_PLANNER_MODEL=openrouter/google/gemini-3.5-flash-lite
# LIBERDEX_ANSWER_MODEL=openrouter/anthropic/claude-sonnet-4.6
# A subscription CLI instead of a key (whole-reply, so use `deep`):
# LIBERDEX_PLANNER_MODEL=claude-cli/opus      # or codex-cli, gemini-cli, opencode-cli

# --- serving beyond localhost (all off by default; `liberdex serve` flags override)
# LIBERDEX_KEYS=            # comma-separated keys callers must present as Bearer
# LIBERDEX_CORS=            # comma-separated origins a browser may call from
# LIBERDEX_MAX_INFLIGHT=8   # searches running at once; beyond it, 503 + Retry-After
# LIBERDEX_SETTINGS=        # 1 forces the page's settings drawer on, 0 off
#                           # (default: on for a loopback bind only)

# Shared plan cache, asked before the planner runs. The key is issued on
# first use and written to ~/.config/liberdex/env.
# LIBERDEX_COMMONS_URL=https://commons.liberdex.net
# LIBERDEX_COMMONS_KEY=

# Optional: raises route rate limits. Both are free and need no signup review.
# STACKEXCHANGE_KEY=      # stackapps.com: 300/day anon -> 10,000/day
# GITHUB_TOKEN=           # 10 req/min unauth -> 30 req/min

# --- ranking models and paths (defaults are what the container ships)
# LIBERDEX_RERANK_MODEL=ms-marco-MiniLM-L-12-v2
# LIBERDEX_EMBED_MODEL=minishlab/potion-retrieval-32M
# LIBERDEX_MODEL_DIR=     # where the two models are cached
# LIBERDEX_PORT=8080      # `liberdex serve` default; --port overrides
# LIBERDEX_PLAN_CACHE=0   # disable the local plan cache
